+"""Verify and merge original v9 ledger segments without overwriting evidence."""
+import argparse
+from collections import Counter, defaultdict
+import json
+from pathlib import Path
+from runpy import run_path
+import sys
+
+NOTES = Path(__file__).resolve().parent
+ROOT = NOTES.parents[3]
+sys.path.insert(0, str(ROOT / 'tools'))
+from evidence_archive import verify_batch
+from formal_results import read_reference, read_results, reference, require, validate_result, write_exclusive
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--work', type=Path, required=True)
+    parser.add_argument('--plan', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--require-complete', action='store_true')
+    args = parser.parse_args()
+    require(Path.cwd().resolve() == ROOT, 'Run synchronization from the main checkout')
+    sync = run_path(str(NOTES / 'sync-v9-after-pending.py'))
+    base = run_path(str(NOTES / 'sync-formal-v9-resume.py'))
+    report = run_path(str(NOTES / 'report-formal-v9.py'))
+    source, iteration = base['SOURCE'], base['ITERATION']
+    work = args.work
+    require(not work.is_absolute() and work.parts[:len(base['NOTES'].parts)] == base['NOTES'].parts and
+            (ROOT / work).resolve().is_relative_to(NOTES), 'Final evidence directory outside project')
+    plan = json.loads(args.plan.read_bytes())
+    require(plan == json.loads((source / work / 'registration.json').read_bytes()), 'Executed plan differs')
+    sync['copy_verified'](source, work / 'registration.json')
+    manifest = read_reference(ROOT, plan['manifest'])
+    gold = read_reference(ROOT, manifest['material']['gold'])['cases']
+    fixture = read_reference(ROOT, manifest['material']['fixture'])['cases']
+    original = read_results(ROOT, manifest, ROOT / base['LEDGER'])
+    require(len(original) == 348 and len(manifest['units']) == 534, 'Original inventory changed')
+    previous = read_reference(ROOT, plan['previous_registration'])
+    require(len(previous['registered_units']) == len(plan['prior_supplemental_results']) == 100,
+            'Previous continuation changed')
+    original_refs = previous['original_records']
+    require(original_refs == [reference(ROOT, base['LEDGER'] / f'{i:04d}.json') for i in range(348)],
+            'Historical ledger changed')
+    disposition = plan['held_attempt_disposition']
+    for migration_ref in (disposition['original_intent'], disposition['original_batch_seal'],
+                          *disposition['original_launch_files'].values()):
+        read_reference(ROOT, migration_ref)
+    entries = {r['ordinal'] - 1: r for r in plan['registered_units']}
+    require(list(entries) == [348, *range(449, 534)], 'Unexpected final tail scope')
+    units = []
+    all_runs, all_reviews = set(), set()
+    counts, failure_stages = Counter(), Counter()
+    arms, blocks = defaultdict(Counter), defaultdict(dict)
+    categories = defaultdict(lambda: defaultdict(Counter))
+    usage_by_arm, review_usage = defaultdict(Counter), Counter()
+    new_counts = Counter()
+    for i, unit in enumerate(manifest['units']):
+        item = {**{k: unit[k] for k in ('unit_id', 'case_id', 'arm', 'repetition', 'block_id')},
+                'ordinal': i + 1, 'category': fixture[unit['case_id']]['category'], 'status': 'not_run'}
+        result = None
+        if i < 348:
+            result, ref = original[i], original_refs[i]
+            review_id = report['verify_review'](i, result)
+        elif 349 <= i < 449:
+            ref = plan['prior_supplemental_results'][i - 349]
+            result = read_reference(ROOT, ref)
+            directory = (ROOT / ref['path']).parent
+            require(result['dispatch_intent'] == reference(ROOT, directory / 'intent.json'), 'Wrong prior reservation')
+            sync['verify_review'](directory, result)
+            review_id = review_response_id(result)
+        else:
+            entry = entries[i]
+            require((entry['unit_id'], entry['arm']) == (unit['unit_id'], unit['arm']), 'Wrong tail unit')
+            directory = work / f'{i:04d}'
+            if (source / directory / 'result.json').exists():
+                batch = iteration / entry['batch']
+                old_seal = verify_batch(source / batch)
+                sync['copy_tree'](source, batch)
+                require(verify_batch(ROOT / batch) == old_seal, 'Mirrored batch changed')
+                sync['copy_tree'](source, directory)
+                ref = reference(ROOT, directory / 'result.json')
+                result = read_reference(ROOT, ref)
+                require(result['dispatch_intent'] == reference(ROOT, directory / 'intent.json'), 'Unregistered attempt')
+                observation = read_reference(ROOT, result['observation'])
+                require(observation['seal'] == reference(ROOT, batch / 'seal.json'), 'Wrong formal batch seal')
+                sync['verify_review'](ROOT / directory, result)
+                review_id = review_response_id(result)
+                item['batch'] = entry['batch']
+            elif i == 348 or (source / directory / 'intent.json').exists():
+                item['status'] = 'pending'
+        if result is not None:
+            validate_result(ROOT, manifest, unit, result)
+            run_id = result['run_id']
+            require(not run_id or run_id not in all_runs, 'Duplicate run ID')
+            if run_id:
+                all_runs.add(run_id)
+            require(review_id not in all_reviews, 'Duplicate review response ID')
+            all_reviews.add(review_id)
+            item.update(status=result['status'], result=ref, run_id=run_id, review_response_id=review_id)
+            observation = read_reference(ROOT, result['observation'])
+            requests = observation['provider_requests']
+            usage = usage_by_arm[unit['arm']]
+            usage['recorded_product_requests'] += len(requests)
+            for request in requests:
+                if request.get('usage') is None:
+                    usage['unknown_product_token_requests'] += 1
+                else:
+                    usage['known_product_tokens'] += request['usage']['total_tokens']
+            review_usage['bound_responses'] += 1
+            provider = read_reference(ROOT, read_reference(ROOT, result['ai_review'])['provider'])
+            if provider.get('usage') is None:
+                review_usage['unknown_token_responses'] += 1
+            else:
+                review_usage['known_tokens'] += provider['usage']['total_tokens']
+            if item['status'] != 'passed':
+                item['failure'] = report['failure_evidence'](result, gold[unit['case_id']])
+                failure_stages[item['failure']['stage']] += 1
+        if i in entries:
+            new_counts[item['status']] += 1
+        counts[item['status']] += 1
+        arms[unit['arm']][item['status']] += 1
+        categories[unit['arm']][item['category']][item['status']] += 1
+        blocks[unit['block_id']][unit['arm']] = item['status']
+        units.append(item)
+    comparison = report['comparison']
+    quality_pairs = Counter(comparison(row['H0'], row['H1-S0']) for row in blocks.values())
+    qp_pairs = Counter(comparison(row['H1-S0'], row['H1-S1']) for row in blocks.values() if 'H1-S1' in row)
+    complete = len(all_reviews) == len(units) and counts['pending'] == counts['not_run'] == 0
+    require(complete or not args.require_complete, 'Formal matrix still has open units')
+    result = {'manifest': plan['manifest'], 'source_revision': manifest['source_revision'],
+              'experiment_id': manifest['experiment_id'], 'exposure': manifest['exposure'],
+              'registration': reference(ROOT, work / 'registration.json'), 'original_held_attempt': disposition,
+              'planned': len(units), 'recorded': len(all_reviews), 'pending': counts['pending'],
+              'not_run': counts['not_run'], 'execution_complete': complete, 'counts': dict(counts),
+              'last_86_counts': dict(new_counts), 'provider_reviews_revalidated': len(all_reviews),
+              'statuses_by_arm': dict(arms), 'statuses_by_arm_category': dict(categories),
+              'recorded_product_usage_by_arm': dict(usage_by_arm), 'bound_review_usage': dict(review_usage),
+              'H0_vs_H1-S0_block_counts': dict(quality_pairs),
+              'S0_vs_S1_QP_block_counts': dict(qp_pairs), 'failure_stage_counts': dict(failure_stages)}
+    write_exclusive(args.output, {**result, 'units': units})
+    print(json.dumps(result, ensure_ascii=False))
+
+
+def review_response_id(result):
+    return read_reference(ROOT, read_reference(ROOT, result['ai_review'])['provider'])['provider_response_id']
+
+
+if __name__ == '__main__':
+    main()
