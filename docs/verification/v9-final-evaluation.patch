@@ -0,0 +1,119 @@
+"""Run the original v9 final tail after a proved pre-collector launch failure."""
+import argparse
+import inspect
+import json
+from pathlib import Path
+from runpy import run_path
+import sys
+
+NOTES = Path('artifacts/iterations/SF-I001/development-notes')
+ROOT = Path.cwd().resolve()
+ITERATION = NOTES.parent
+OPERATION = Path(__file__).resolve().parent
+sys.path.insert(0, str(ROOT / 'tools'))
+from evidence_archive import verify_batch
+from formal_results import read_reference, reference, require, unit_binding, write_exclusive
+from formal_scheduler import scheduler_owner
+
+HELD = 348
+TAIL = 449
+RECOVERY_BATCH = 'SF-B13534-formal-unit-recovery'
+PRIOR_DIR = NOTES / 'v9-after-pending-20261121'
+
+
+def replacement_proof(old_plan, manifest):
+    """Verify the specific Docker timeout occurred before the collector could start."""
+    batch = ITERATION / 'SF-B13348-formal-unit'
+    require(old_plan['held_batch_seal'] == reference(ROOT, batch / 'seal.json'), 'Held seal changed')
+    require(verify_batch(ROOT / batch)['counts']['error'] == 1, 'Expected one sealed execution error')
+    folder = NOTES / 'formal-native-20261117-v9-work' / f'{HELD:04d}'
+    files = {name: reference(ROOT, folder / f'{name}.json') for name in ('started', 'input', 'launch', 'exit')}
+    started = read_reference(ROOT, files['started'])
+    launch = read_reference(ROOT, files['launch'])
+    prior_input = read_reference(ROOT, files['input'])
+    binding = unit_binding(manifest, manifest['units'][HELD])
+    require(started['binding'] == binding and started['input'] == files['input'] and
+            prior_input['formal_unit'] == {'binding': binding, 'dispatch_intent': old_plan['held_reservation']} and
+            launch['intent'] == old_plan['held_reservation'] and read_reference(ROOT, files['exit'])['exit_code'] != 0,
+            'Original attempt is not bound to the held unit')
+    log = batch / 'raw/runner.log'
+    lines = (ROOT / log).read_text(encoding='utf-8-sig', errors='replace')
+    require(all(text in lines for text in ('in run_native', 'actual = host_observation(',
+            "subprocess.TimeoutExpired: Command '['docker', 'info'", 'timed out after 20 seconds',
+            f'Drain OK for {binding["namespace"]} (temporary PGDATA and loopback port 18080).',
+            'SF_WINDOW_RELEASED ')), 'Cannot prove the pre-collector failure and drain')
+    require(not any((ROOT / batch / 'raw').rglob('five-case-native.json')) and
+            not any((ROOT / batch / 'raw').rglob('formal-recovery-observation.json')),
+            'Unexpected native observations require reconciliation')
+    from five_case_matrix_runtime import run_native
+    source = inspect.getsource(run_native)
+    require(source.index('actual = host_observation(') < source.index('"run", "--name", name'),
+            'Frozen runner order changed')
+    return {'original_batch': batch.name, 'original_batch_seal': old_plan['held_batch_seal'],
+            'original_intent': old_plan['held_reservation'], 'original_launch_files': files,
+            'runner_log': reference(ROOT, log), 'runner_source': reference(ROOT, 'tools/five_case_matrix_runtime.py'),
+            'observed_failure': 'docker_info_timeout_before_collector_launch',
+            'sql_recovery_observation': None, 'old_reservation_replay_allowed': False,
+            'replacement_scope': 'new batch and nonce in a newly provisioned disposable database'}
+
+
+def make_plan(previous, manifest):
+    prior_registration = reference(ROOT, PRIOR_DIR / 'registration.json')
+    require(read_reference(ROOT, prior_registration) == previous, 'Prior 100 registration changed')
+    require(len(manifest['units']) == 534, 'Wrong matrix denominator')
+    prior = [reference(ROOT, PRIOR_DIR / f'{index:04d}/result.json') for index in range(HELD + 1, TAIL)]
+    entries = [{'ordinal': index + 1, 'unit_id': manifest['units'][index]['unit_id'],
+                'arm': manifest['units'][index]['arm'],
+                'batch': RECOVERY_BATCH if index == HELD else f'SF-B{13000+index}-formal-unit'}
+               for index in (HELD, *range(TAIL, len(manifest['units'])))]
+    return {'kind': 'original_v9_final_tail', 'manifest': previous['manifest'],
+            'previous_registration': prior_registration, 'prior_supplemental_results': prior,
+            'held_attempt_disposition': replacement_proof(previous, manifest), 'registered_units': entries}
+
+
+def run(target, continuation, previous, plan, manifest, original_rows, *, held_only):
+    continuation['verify_context'](previous, manifest)
+    require(not (ROOT / PRIOR_DIR / '.scheduler.lock').exists(), 'Prior continuation is active')
+    frozen = run_path(str(ROOT / NOTES / 'run-formal-v9-continuation.py'))
+    prior = [*original_rows, *(read_reference(ROOT, ref) for ref in plan['prior_supplemental_results'])]
+    seen = {row['run_id'] for row in prior if row['run_id'] is not None}
+    with scheduler_owner(target):
+        registration = target / 'registration.json'
+        if not registration.exists():
+            require(all(not (ROOT / ITERATION / row['batch']).exists() for row in plan['registered_units']),
+                    'Native batch collision before registration')
+            write_exclusive(registration, plan)
+        require(read_reference(ROOT, reference(ROOT, registration)) == plan, 'Final tail registration changed')
+        entries = plan['registered_units'][:1] if held_only else plan['registered_units']
+        for entry in entries:
+            index = entry['ordinal'] - 1
+            folder = target / f'{index:04d}'
+            folder.mkdir(exist_ok=True)
+            print(json.dumps({**entry, 'stage': 'starting_or_resuming'}), flush=True)
+            if not (folder / 'result.json').exists():
+                continuation['run_unit'](plan, manifest, index, folder, frozen, batch_id=entry['batch'],
+                    previous_batch='SF-B13348-formal-unit' if index == HELD else None)
+            record = continuation['existing_result'](manifest, index, folder, seen)
+            print(json.dumps({**entry, 'status': record['status']}), flush=True)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('operation', choices=('plan', 'held', 'run'))
+    parser.add_argument('--work', required=True, type=Path)
+    parser.add_argument('--output', type=Path)
+    args = parser.parse_args()
+    target = args.work.resolve()
+    require(target.is_relative_to((ROOT / NOTES).resolve()), 'Work outside project evidence')
+    continuation = run_path(str(OPERATION / 'run-v9-after-pending.py'))
+    previous, manifest, original_rows = continuation['basis']()
+    plan = make_plan(previous, manifest)
+    if args.operation == 'plan':
+        require(args.output is not None, 'Output required for registration')
+        write_exclusive(args.output, plan)
+        return
+    run(target, continuation, previous, plan, manifest, original_rows, held_only=args.operation == 'held')
+
+
+if __name__ == '__main__':
+    main()
