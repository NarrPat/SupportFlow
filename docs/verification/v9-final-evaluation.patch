@@ -0,0 +1,91 @@
+"""Reassess a formal v9 failure only when corrected evidence can be projected."""
+import argparse
+import json
+from pathlib import Path
+from runpy import run_path
+import subprocess
+import sys
+
+NOTES = Path(__file__).resolve().parent
+ROOT = NOTES.parents[3]
+sys.path.insert(0, str(ROOT / 'tools'))
+from formal_ai_review import packet, validate_judgment
+from formal_results import read_reference, reference, require, validate_result, write_exclusive
+from formal_scheduler import assemble, scheduler_owner
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('report', type=Path)
+    parser.add_argument('output', type=Path)
+    parser.add_argument('--unit', action='append', required=True)
+    parser.add_argument('--projection-only', action='store_true')
+    args = parser.parse_args()
+    target = args.output.resolve()
+    require(Path.cwd().resolve() == ROOT and target.is_relative_to(NOTES) and not target.exists(),
+            'New evidence directory in the main checkout required')
+    report_ref = reference(ROOT, args.report)
+    report = read_reference(ROOT, report_ref)
+    manifest = read_reference(ROOT, report['manifest'])
+    picked = set(args.unit)
+    rows = [row for row in report['units'] if row['unit_id'] in picked]
+    require(len(rows) == len(picked) == len(args.unit) and all(
+        row['ordinal'] >= 450 and row['failure']['stage'] == 'semantic_review' for row in rows),
+        'Only identified review-only failures in the final original tail are eligible')
+    review_unit = run_path(str(NOTES / 'run-v9-remaining-sample.py'))['review_unit']
+    source = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip()
+    if not args.projection_only:
+        require(not subprocess.check_output(['git', 'diff', 'HEAD', '--name-only'], cwd=ROOT, text=True).strip(),
+                'Commit the reviewer changes before an online recheck')
+    outcomes = []
+    with scheduler_owner(target):
+        for row in rows:
+            uid = row['unit_id']
+            original = read_reference(ROOT, row['result'])
+            validate_result(ROOT, manifest, manifest['units'][row['ordinal'] - 1], original)
+            original_dir = (ROOT / row['result']['path']).parent
+            previous_pending = reference(ROOT, original_dir / 'collected/pending-review.json')
+            pending = read_reference(ROOT, previous_pending)
+            prior_review = read_reference(ROOT, original['ai_review'])
+            prior_packet = read_reference(ROOT, prior_review['attempt'])['packet']
+            directory = target / uid.lower()
+            directory.mkdir()
+            candidate = directory / 'pending-review.json'
+            write_exclusive(candidate, {**pending, 'review_packet_version': 10,
+                                        'review_input': reference(ROOT, original_dir / 'input.json')})
+            observed, _ = packet(ROOT, candidate)
+            require(observed['independent_passed'] and not observed['collection_error'] and
+                    observed['requirements'] == prior_packet['requirements'] and observed['actual'] != prior_packet['actual'],
+                    'Corrected projection is missing or does not bind the same requirements')
+            write_exclusive(directory / 'projection.json', observed)
+            outcome = {'unit_id': uid, 'original': row['result'], 'run_id': original['run_id'], 'batch': row['batch'],
+                       'original_pending': previous_pending, 'review_source_revision': source,
+                       'reviewer_code': reference(ROOT, 'tools/formal_ai_review.py'),
+                       'packet': reference(ROOT, directory / 'projection.json'), 'status': 'offline_projection'}
+            if not args.projection_only:
+                output = review_unit(directory, candidate, directory / 'ai-review.json')
+                outcome['status'] = 'pending'
+                if output is not None:
+                    result = assemble(ROOT, manifest, candidate, output)
+                    review = read_reference(ROOT, result['ai_review'])
+                    reply = read_reference(ROOT, review['provider'])
+                    attempt = read_reference(ROOT, review['attempt'])
+                    judgment = validate_judgment(observed, reply['content'])
+                    require(attempt['pending'] == reference(ROOT, candidate) and attempt['packet'] == observed and
+                            all(review[k] == value for k, value in judgment.items()) and
+                            all(original[k] == result[k] for k in ('binding', 'run_id', 'dispatch_intent',
+                                                                  'observation', 'independent_score')),
+                            'Review-only recheck changed the formal observation or score')
+                    result['mode'] = 'seen_formal_repair_review_only'
+                    write_exclusive(directory / 'recheck.json', result)
+                    outcome.update(status=result['status'], bound_review=reference(ROOT, directory / 'recheck.json'))
+            write_exclusive(directory / 'outcome.json', outcome)
+            outcomes.append(outcome)
+            print(json.dumps(outcome, ensure_ascii=False), flush=True)
+    write_exclusive(target / 'outcomes.json', {'origin_report': report_ref, 'source_revision': source,
+                                               'formal_eligible': False, 'units': outcomes})
+    return int(any(row['status'] not in ('passed', 'offline_projection') for row in outcomes))
+
+
+if __name__ == '__main__':
+    sys.exit(main())
