+"""Independently verify repaired observations and record initial and final outcomes."""
+import argparse
+from collections import Counter
+from pathlib import Path
+import sys
+
+ROOT = Path.cwd()
+NOTES = Path(__file__).resolve().parent
+sys.path.insert(0, str(ROOT / 'tools'))
+from evidence_archive import verify_batch
+from formal_ai_review import packet, validate_judgment
+from formal_results import read_reference, reference, require, write_exclusive
+from formal_unit_material import V9_AFTER_PENDING_REPAIR, V9_CONTINUATION_REPAIR, V9_FINAL_TAIL_REPAIR
+
+
+def review(row, directory):
+    bound = read_reference(ROOT, row['bound_review'])
+    original = read_reference(ROOT, row['original'])
+    require({k: bound['binding'][k] for k in ('unit_id', 'arm', 'repetition', 'case_id', 'common_sha256')}
+            == {k: original['binding'][k] for k in ('unit_id', 'arm', 'repetition', 'case_id', 'common_sha256')},
+            'Repaired result changed the original unit')
+    if bound['mode'] == 'seen_formal_repair_review_only':
+        require(all(original[k] == bound[k] for k in ('binding', 'run_id', 'dispatch_intent',
+                                                      'observation', 'independent_score')),
+                'Review-only projection changed the formal observation or score')
+    else:
+        require(bound['binding']['experiment_id'] != original['binding']['experiment_id'] and
+                bound['mode'] == 'dev_formal_path_calibration', 'Repair is not separated from the original registration')
+    if 'previous_outcome' in row:
+        previous = read_reference(ROOT, row['previous_outcome'])
+        previous_record = read_reference(ROOT, previous['bound_review'])
+        require(all(previous_record[k] == bound[k] for k in ('binding', 'run_id', 'dispatch_intent',
+                                                             'observation', 'independent_score')),
+                'Review-only recheck changed native inputs or independently scored evidence')
+    batch = NOTES.parent / row['batch']
+    verify_batch(batch)
+    obs = read_reference(ROOT, bound['observation'])
+    require(obs['seal'] == reference(ROOT, batch / 'seal.json'), 'Wrong native seal')
+    review_result = read_reference(ROOT, bound['ai_review'])
+    approval = read_reference(ROOT, review_result['provider'])
+    attempt = read_reference(ROOT, review_result['attempt'])
+    pending = ROOT / attempt['pending']['path']
+    require(reference(ROOT, pending) == attempt['pending'], 'Wrong review input bytes')
+    evidence, collected = packet(ROOT, pending)
+    require(attempt['packet'] == evidence and collected['observation'] == bound['observation'] and
+            collected['independent_score'] == bound['independent_score'], 'Review is not bound to collected evidence')
+    verdict = validate_judgment(evidence, approval['content'])
+    require(all(review_result[k] == v for k, v in verdict.items()) and approval['provider_response_id'],
+            'Review differs from validated provider reply')
+    expected = 'error' if obs['collection_error'] else (
+        'passed' if evidence['independent_passed'] and verdict['decision'] == 'approved' else 'failed')
+    require(expected == bound['status'] == row['status'], 'Result differs from observed score and review')
+    return {'source': bound['binding']['source_revision'], 'run_id': bound['run_id'],
+            'batch': row['batch'], 'observation': bound['observation'], 'score': bound['independent_score'],
+            'review': bound['ai_review'], 'record': reference(ROOT, directory / 'outcome.json'),
+            'provider_response_id': approval['provider_response_id']}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('output', type=Path)
+    parser.add_argument('runs', type=Path, nargs='+')
+    fixtures = {'continuation': V9_CONTINUATION_REPAIR, 'after-pending': V9_AFTER_PENDING_REPAIR,
+                'final-tail': V9_FINAL_TAIL_REPAIR}
+    parser.add_argument('--scope', choices=fixtures, default='continuation')
+    args = parser.parse_args()
+    scope = read_reference(ROOT, reference(ROOT, fixtures[args.scope]))
+    historical = read_reference(ROOT, scope['origin_report'])
+    if args.scope == 'continuation':
+        valid = (historical['recorded'], historical['pending']) == (348, 1)
+    elif args.scope == 'after-pending':
+        valid = (historical['combined_recorded'], historical['combined_pending'], historical['combined_not_run'],
+                 historical['supplemental_recorded']) == (448, 1, 85, 100)
+    else:
+        valid = (historical['recorded'], historical['pending'], historical['not_run']) == (534, 0, 0)
+    require(valid, 'Original matrix boundary changed')
+    units = {u['unit_id']: {**u, 'attempts': []} for u in scope['units']}
+    for path in args.runs:
+        for record in sorted(path.glob('*/outcome.json')):
+            item = read_reference(ROOT, reference(ROOT, record))
+            unit = units[item['unit_id']]
+            require(item['original'] == unit['result'], 'Wrong original result')
+            attempt = {**item, 'outcome': reference(ROOT, record)}
+            if item.get('bound_review'):
+                attempt['verified_evidence'] = review(item, record.parent)
+            unit['attempts'].append(attempt)
+    for unit in units.values():
+        attempts = unit['attempts']
+        unit['status'] = next((a['status'] for a in reversed(attempts) if a['status'] == 'passed'),
+                              attempts[-1]['status'] if attempts else 'not_run')
+    counts = Counter(u['status'] for u in units.values())
+    write_exclusive(args.output, {'origin_report': scope['origin_report'], 'formal_eligible': False,
+                                  'requested': len(units), 'counts': dict(counts), 'units': list(units.values())})
+    print(dict(counts))
+    return int(counts['passed'] != len(units))
+
+
+if __name__ == '__main__':
+    sys.exit(main())
