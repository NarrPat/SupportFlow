+++ b/artifacts/iterations/SF-I001/development-notes/run-v9-after-pending.py
@@ -0,0 +1,179 @@
+"""Execute a registered continuation after a preserved pending v9 reservation."""
+import argparse
+from collections import Counter
+from datetime import datetime, timezone
+import json
+from pathlib import Path
+from runpy import run_path
+import subprocess
+import sys
+from uuid import uuid4
+
+ROOT = Path.cwd().resolve()
+NOTES = Path('artifacts/iterations/SF-I001/development-notes')
+ORIGINAL = NOTES / 'formal-native-20261117-v9'
+LEDGER = ROOT / NOTES / 'formal-native-20261117-v9-ledger'
+WORK = ROOT / NOTES / 'formal-native-20261117-v9-work'
+BEGIN, END = 349, 449  # zero-based, end exclusive
+sys.path.insert(0, str(ROOT / 'tools'))
+from formal_results import (pending_intent, read_reference, read_results, reference, require,
+                            unit_binding, validate_gate, validate_intent, write_exclusive)
+from formal_scheduler import assemble, native_command, scheduler_owner
+from formal_unit_material import build
+from formal_unit_result import collect
+
+
+def batch(index):
+    return f'SF-B{13000 + index}-formal-unit'
+
+
+def read(path):
+    return json.loads(path.read_bytes())
+
+
+def basis():
+    manifest_ref = reference(ROOT, ORIGINAL / 'manifest.json')
+    manifest = read_reference(ROOT, manifest_ref)
+    validate_gate(ROOT, manifest)
+    original_rows = read_results(ROOT, manifest, LEDGER)
+    require(len(original_rows) == BEGIN - 1, 'Original ledger boundary changed')
+    pending = pending_intent(ROOT, manifest, LEDGER, len(original_rows))
+    require(pending and manifest['units'][BEGIN - 1]['unit_id'] == 'SF-045-r2-H1-S0',
+            'Expected the original held reservation')
+    original_records = [reference(ROOT, LEDGER / f'{i:04d}.json') for i in range(len(original_rows))]
+    units = [{'ordinal': i + 1, 'unit_id': manifest['units'][i]['unit_id'],
+              'arm': manifest['units'][i]['arm'], 'batch': batch(i)} for i in range(BEGIN, END)]
+    plan = {'kind': 'v9_continuation_after_pending', 'manifest': manifest_ref,
+            'original_records': original_records, 'held_reservation': pending,
+            'held_batch_seal': reference(ROOT, Path('artifacts/iterations/SF-I001') / batch(BEGIN - 1) / 'seal.json'),
+            'registered_units': units, 'original_denominator': len(manifest['units'])}
+    return plan, manifest, original_rows
+
+
+def verify_context(plan, manifest):
+    require(subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip()
+            == manifest['source_revision'], 'Wrong frozen source')
+    require(not subprocess.check_output(['git', 'diff', 'HEAD', '--name-only'], text=True).strip(),
+            'Frozen product source changed')
+    require(not (WORK / '.scheduler.lock').exists(), 'Original scheduler active')
+    for ref in (*plan['original_records'], plan['held_reservation'], plan['held_batch_seal']):
+        require(ref == reference(ROOT, ref['path']), 'Original evidence changed')
+
+
+def existing_result(manifest, index, folder, seen):
+    record = read(folder / 'result.json')
+    require(record == assemble(ROOT, manifest, folder / 'collected/pending-review.json',
+                               folder / 'ai-review.json'), 'Stored result differs from its sealed review')
+    require(record['binding'] == unit_binding(manifest, manifest['units'][index]), 'Result on the wrong unit')
+    require(record['dispatch_intent'] == reference(ROOT, folder / 'intent.json'), 'Reservation differs')
+    run_id = record['run_id']
+    if run_id is not None:
+        require(run_id not in seen, 'Run reused across v9 units')
+        seen.add(run_id)
+    return record
+
+
+def execute(path, plan, manifest, original_rows):
+    verify_context(plan, manifest)
+    frozen = run_path(str(ROOT / NOTES / 'run-formal-v9-continuation.py'))
+    seen = {row['run_id'] for row in original_rows if row['run_id'] is not None}
+    with scheduler_owner(path):
+        registration = path / 'registration.json'
+        if not registration.exists():
+            require(all(not (ROOT / 'artifacts/iterations/SF-I001' / u['batch']).exists()
+                        for u in plan['registered_units']), 'A target already has a native batch')
+            write_exclusive(registration, plan)
+        require(read(registration) == plan, 'Supplemental continuation registration differs')
+        for index in range(BEGIN, END):
+            unit = manifest['units'][index]
+            folder = path / f'{index:04d}'
+            folder.mkdir(exist_ok=True)
+            if not (folder / 'result.json').exists():
+                run_unit(plan, manifest, index, folder, frozen)
+            result = existing_result(manifest, index, folder, seen)
+            print(json.dumps({'ordinal': index + 1, 'unit_id': unit['unit_id'],
+                              'status': result['status'], 'batch': batch(index)}), flush=True)
+
+
+def run_unit(plan, manifest, index, folder, frozen, *, batch_id=None, previous_batch=None):
+    unit = manifest['units'][index]
+    binding = unit_binding(manifest, unit)
+    intent = folder / 'intent.json'
+    launch = folder / 'launch.json'
+    batch_id = batch_id or batch(index)
+    batch_dir = ROOT / 'artifacts/iterations/SF-I001' / batch_id
+    if not intent.exists():
+        require(not launch.exists() and not batch_dir.exists(), 'Native launch without reservation')
+        observed = frozen['preflight'](ROOT)
+        write_exclusive(folder / ('preflight-' + uuid4().hex + '.json'), observed)
+        require(observed['status'] == 'passed', 'Host preflight blocked before reservation')
+        write_exclusive(intent, {'schema_version': 1, 'state': 'reserved', 'binding': binding,
+                                 'nonce': uuid4().hex, 'reserved_at': datetime.now(timezone.utc).isoformat()})
+    validate_intent(binding, read(intent))
+    input_path = folder / 'input.json'
+    prepared = build(ROOT, plan['manifest'], reference(ROOT, intent))
+    if not input_path.exists():
+        require(not launch.exists() and not batch_dir.exists(), 'Missing prepared input after launch')
+        write_exclusive(input_path, prepared)
+    require(read(input_path) == prepared, 'Prepared input changed')
+    if not launch.exists():
+        require(not batch_dir.exists() and not (folder / 'started.json').exists(), 'Native batch already started')
+        command = native_command(ROOT, batch_id, previous_batch or batch(index - 1), unit['arm'], input_path)
+        write_exclusive(launch, {'command': command, 'intent': reference(ROOT, intent)})
+        with (folder / 'console.log').open('xb') as log:
+            code = subprocess.run(command, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT).returncode
+        write_exclusive(folder / 'exit.json', {'exit_code': code})
+    require((batch_dir / 'seal.json').is_file(), 'No seal for reserved execution. Keep pending.')
+    collected = folder / 'collected'
+    pending = collected / 'pending-review.json'
+    if not collected.exists():
+        collect(ROOT, input_path, batch_dir, collected)
+    require(pending.is_file(), 'Partial collection. Keep pending.')
+    review = folder / 'ai-review.json'
+    if not review.exists():
+        frozen['reviewer'](ROOT, pending, review)
+    result = assemble(ROOT, manifest, pending, review)
+    write_exclusive(folder / 'result.json', result)
+
+
+def report(path, plan, manifest, original_rows):
+    if (path / 'registration.json').exists():
+        require(read(path / 'registration.json') == plan, 'Supplemental registration differs')
+    seen = {row['run_id'] for row in original_rows if row['run_id'] is not None}
+    units = []
+    for index, entry in enumerate(plan['registered_units'], BEGIN):
+        folder = path / f'{index:04d}'
+        if (folder / 'result.json').exists():
+            status = existing_result(manifest, index, folder, seen)['status']
+            units.append({**entry, 'status': status, 'result': reference(ROOT, folder / 'result.json')})
+        else:
+            status = 'pending' if (folder / 'intent.json').exists() else 'not_run'
+            units.append({**entry, 'status': status})
+    counts = Counter(row['status'] for row in units)
+    completed = sum(counts[s] for s in ('passed', 'failed', 'error'))
+    return {'registration': plan, 'supplemental_counts': dict(counts), 'supplemental_recorded': completed,
+            'combined_recorded': len(original_rows) + completed, 'combined_pending': 1 + counts['pending'],
+            'combined_not_run': len(manifest['units']) - len(original_rows) - completed - 1 - counts['pending'],
+            'units': units}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('operation', choices=('plan', 'run', 'report'))
+    parser.add_argument('--work', required=True, type=Path)
+    parser.add_argument('--output', type=Path)
+    args = parser.parse_args()
+    path = args.work.resolve()
+    require(path.is_relative_to((ROOT / NOTES).resolve()), 'Work outside frozen project evidence')
+    plan, manifest, original_rows = basis()
+    if args.operation == 'run':
+        execute(path, plan, manifest, original_rows)
+        return
+    result = plan if args.operation == 'plan' else report(path, plan, manifest, original_rows)
+    if args.output is not None:
+        write_exclusive(args.output, result)
+    print(json.dumps({k: v for k, v in result.items() if k not in ('original_records', 'registration', 'units', 'registered_units')}))
+
+
+if __name__ == '__main__':
+    main()
