+    groups = {group: {a['assertion_id'].removeprefix(f"{item['case_id']}.{group}."): a
+                      for a in assertions if a['assertion_id'].startswith(f"{item['case_id']}.{group}.")}
+              for group in ('integrity', 'duplicate_write', 'authority')}
+    integrity = item.get('integrity_control') or {}
+    if integrity.get('run_id') == item.get('target_run_id') and groups['integrity']:
+        facts = groups['integrity']
+        original = facts['original_parameters']['actual']
+        changed = facts['changed_command']['actual']
+        return 'immutable_proposal', {
+            'approved_parameters': dict(zip(('seats', 'days'), original, strict=True)),
+            'observed_replacement': {field: changed[field] for field in ('seats', 'days')},
