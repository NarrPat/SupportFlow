diff --git a/artifacts/iterations/SF-I001/development-notes/run-v9-continuation-repair.py b/artifacts/iterations/SF-I001/development-notes/run-v9-continuation-repair.py
new file mode 100644
index 00000000..6628dcd4
--- /dev/null
+++ b/artifacts/iterations/SF-I001/development-notes/run-v9-continuation-repair.py
@@ -0,0 +1,67 @@
+"""Recheck exactly the nonpassing units of the v9 continuation, under a new registration."""
+import argparse
+import json
+from pathlib import Path
+import runpy
+import subprocess
+import sys
+
+ROOT = Path.cwd()
+NOTES = Path(__file__).resolve().parent
+sys.path.insert(0, str(ROOT / 'tools'))
+from formal_results import create_manifest, read_reference, reference, require, write_exclusive
+from formal_scheduler import scheduler_owner
+from formal_unit_material import V9_CONTINUATION_REPAIR
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('output', type=Path)
+    parser.add_argument('--first-batch', type=int, required=True)
+    parser.add_argument('--previous-batch', required=True)
+    parser.add_argument('--unit', action='append')
+    args = parser.parse_args()
+    target = args.output.resolve()
+    require(target.is_relative_to(NOTES) and not target.exists(), 'New evidence directory required')
+    require(not subprocess.check_output(['git', 'diff', 'HEAD', '--name-only'], text=True).strip(),
+            'Tracked source differs from registered commit')
+    source = subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip()
+    spec = read_reference(ROOT, reference(ROOT, V9_CONTINUATION_REPAIR))
+    history = read_reference(ROOT, spec['origin_report'])
+    original = read_reference(ROOT, spec['origin_manifest'])
+    require(history['manifest'] == spec['origin_manifest'], 'History points to another manifest')
+    rows = [u for u in history['units'][222:348] if u['status'] in ('failed', 'error')]
+    require(len(rows) == 35 and sum(u['status'] == 'failed' for u in rows) == 28,
+            'Historical continuation scope differs')
+    require(spec['unit_ids'] == [u['unit_id'] for u in rows] and spec['units'] == [
+        {'unit_id': u['unit_id'], 'arm': u['arm'], 'repetition': u['repetition'],
+         'original_status': u['status'], 'stage': u['failure']['stage'], 'result': u['result']}
+        for u in rows], 'Repair scope does not match the frozen records')
+    selected = set(args.unit or spec['unit_ids'])
+    require(selected and selected <= set(spec['unit_ids']), 'Unknown unit in repair scope')
+    manifest = create_manifest(ROOT, spec['experiment_prefix'] + target.name, source)
+    require(manifest['material'] == original['material'] and manifest['common'] == original['common'],
+            'Business material or common parameters changed')
+    units = {unit['unit_id']: unit for unit in manifest['units']}
+    run_unit = runpy.run_path(str(NOTES / 'run-v9-remaining-sample.py'))['run_unit']
+    outcomes = []
+    previous = args.previous_batch
+    with scheduler_owner(target):
+        write_exclusive(target / 'manifest.json', manifest)
+        for index, row in enumerate(u for u in rows if u['unit_id'] in selected):
+            uid = row['unit_id']
+            batch = f'SF-B{args.first_batch + index}-v9-continuation-recheck'
+            outcome = run_unit(target, manifest, units[uid], batch, previous)
+            outcome['original'] = row['result']
+            write_exclusive(target / uid.lower() / 'outcome.json', outcome)
+            print(json.dumps(outcome, ensure_ascii=False), flush=True)
+            outcomes.append(outcome)
+            if (NOTES.parent / batch / 'seal.json').is_file():
+                previous = batch
+        write_exclusive(target / 'outcomes.json', {'source_revision': source, 'formal_eligible': False,
+                                                   'units': outcomes})
+    return int(any(row['status'] != 'passed' for row in outcomes))
+
+
+if __name__ == '__main__':
+    sys.exit(main())
