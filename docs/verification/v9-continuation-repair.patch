+            'replacement_hash_conflicts': facts['independent_hash_conflict']['actual'],
+            'terminal_reason': facts['terminal']['actual'][1],
+            'no_downstream_grant_http': facts['no_grant_http']['passed'],
+            'business_state_unchanged': facts['zero_agent_write']['passed'],
+        }
+    replay = item.get('duplicate_write_control') or {}
+    if (replay.get('operation') == 'repeat_same_decision'
+            and replay.get('run_id') == item.get('target_run_id') and groups['duplicate_write']):
+        facts = groups['duplicate_write']
+        return 'repeated_approval', {
+            'observed_decision_requests': facts['decision_http_count']['actual'],
+            'same_request_and_response': facts['same_request']['passed'] and facts['same_response']['passed'],
+            'persisted_decision_count': int(bool(facts['one_decision']['actual'])) if facts['one_decision']['passed'] else None,
+            'resume_outbox_count': facts['resume_once']['actual'],
+            'outbox_unchanged_on_replay': facts['replay_unchanged.outbox']['passed'],
+            'new_receipt_count': facts['one_new_effect']['actual'],
+        }
+    if (item.get('authority_control') or {}).get('operation') == 'revoke_scope' and groups['authority']:
+        facts = groups['authority']
+        return 'customer_scope_revocation', {
